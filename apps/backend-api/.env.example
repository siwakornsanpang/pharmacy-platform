# Runtime application principal only; required values have no fallback.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST:5432/APP_DATABASE
SUPABASE_URL=https://STORAGE_PROJECT.example.invalid
SUPABASE_KEY=REPLACE_WITH_SERVER_STORAGE_KEY
JWT_SECRET=REPLACE_WITH_UNIQUE_STAFF_SIGNING_SECRET
JWT_ISSUER=REPLACE_WITH_STAFF_ISSUER
JWT_AUDIENCE=REPLACE_WITH_STAFF_AUDIENCE
STAFF_SESSION_TTL_SECONDS=3600
CORS_ORIGINS=https://BACKOFFICE.example.invalid,https://PHARMACY_WEB.example.invalid
ACADEMY_BRIDGE_KEY=REPLACE_WITH_UNIQUE_ACADEMY_BRIDGE_KEY
PUBLIC_UPLOAD_BASE_URL=https://RENDER_UPLOAD_ORIGIN.example.invalid
UPLOAD_MAX_BYTES=104857600
UPLOAD_SNIFF_BYTES=65536
PRIVATE_ASSET_TTL_SECONDS=300
# MIGRATION_DATABASE_URL is operator CLI-only; do not set it in deployed runtime.
