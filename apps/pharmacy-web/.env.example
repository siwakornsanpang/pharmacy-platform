# Base server config. Public data reads do not require Conference signing keys.
NODE_ENV=production
BACKEND_API_URL=https://BACKEND.example.invalid
PHARMACY_WEB_ORIGIN=https://PHARMACY_WEB.example.invalid
# Optional integrations: their owning bridge/session accessor validates these lazily.
CONFERENCE_API_URL=https://CONFERENCE.example.invalid
ACADEMY_BRIDGE_KEY=REPLACE_WITH_BACKEND_BRIDGE_KEY
PHARMACY_AUTH_MODE=mock
PHARMACY_SESSION_STORE=memory
PHARMACY_SESSION_TTL_SECONDS=604800
PHARMACY_POC_MODE=false
PHARMACY_SESSION_SECRET=REPLACE_WITH_DISTINCT_PHARMACY_SESSION_SECRET
PHARMACY_ASSERTION_PRIVATE_JWK=REPLACE_WITH_PRIVATE_JWK_FROM_SECRET_MANAGER
PHARMACY_ASSERTION_KEY_ID=REPLACE_WITH_REGISTERED_KEY_ID
PHARMACY_ASSERTION_ISSUER=REPLACE_WITH_ASSERTION_ISSUER
PHARMACY_ASSERTION_AUDIENCE=REPLACE_WITH_ASSERTION_AUDIENCE
# ALLOW_LOCAL_UI_BYPASS is unsupported here; it never grants Pharmacy access.
